# .env.local 로 복사해서 값을 채우세요. (Vercel에는 같은 이름으로 환경변수 등록)

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 공공데이터포털 - 소상공인시장진흥공단_상가(상권)정보 API (일반 인증키 Decoding)
DATA_GO_KR_KEY=

# Google AI Studio
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# --- 아래는 내 PC 수집기(worker)만 사용 ---
# aside 명령이 PATH에 없으면 전체 경로
# ASIDE_BIN=C:\Users\...\aside.exe
# ASIDE_CLI_AUTH_PATH=
